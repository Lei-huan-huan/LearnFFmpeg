<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LearnFFmpeg" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFCFB7FF</item>
        <item name="colorPrimaryVariant">#FFB69DF8</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#FFCCC2DC</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:windowBackground">@color/bg_app_dark</item>
        <item name="android:colorBackground">@color/bg_app_dark</item>
        <item name="android:statusBarColor">@color/bg_app_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>

    <style name="App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_card_dark</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="App.Card.Player" parent="App.Card">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@color/black</item>
        <item name="contentPadding">0dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">22dp</item>
        <item name="backgroundTint">#FFCFB7FF</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">#FFCFB7FF</item>
        <item name="android:textColor">#FFCFB7FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="App.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#FF4F378B</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">#FFCFB7FF</item>
        <item name="hintTextColor">#FFCFB7FF</item>
    </style>

</resources>
